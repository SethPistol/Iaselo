{
  "name": "iaselo",
  "version": "1.1.0",
  "private": true,
  "description": "IASELO — parcours patient périopératoire multiprofessionnel (Clever Cloud)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/build-clever.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs tests/clever/*.test.mjs",
    "test:clever": "node --test tests/clever/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "password:hash": "node scripts/password-hash.mjs",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.mjs",
    "user:password": "node --env-file-if-exists=.env scripts/reset-password.mjs",
    "postinstall": "npm run build",
    "user:mfa-reset": "node --env-file-if-exists=.env scripts/reset-mfa.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "pg": "8.23.1",
    "sts-whisper-small": "1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17"
  }
}
