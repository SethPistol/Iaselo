# Exemple sans identifiant, mot de passe, clé ni secret opérationnel.
# Copier en .env pour les essais locaux ; sur Clever Cloud utiliser la console Environment.
NODE_ENV=production
PORT=8080
BASE_URL=
SESSION_SECRET=
SESSION_HOURS=8

# PostgreSQL : DATABASE_URL ou variables injectées par l’add-on lié.
DATABASE_URL=
POSTGRESQL_ADDON_URI=
POSTGRESQL_ADDON_HOST=
POSTGRESQL_ADDON_PORT=5432
POSTGRESQL_ADDON_DB=
POSTGRESQL_ADDON_USER=
POSTGRESQL_ADDON_PASSWORD=
# verify-full par défaut. disable uniquement pour PostgreSQL local ou réseau privé validé.
PGSSL=verify-full
PGSSL_CA=
PG_POOL_SIZE=5

# Premier compte propriétaire. L’empreinte se génère avec npm run password:hash.
# Ces variables n’ajoutent aucun nouvel administrateur après le premier démarrage.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Cellar : l’add-on lié injecte ces trois variables. Le bucket doit exister et être privé.
CELLAR_ADDON_HOST=
CELLAR_ADDON_KEY_ID=
CELLAR_ADDON_KEY_SECRET=
S3_BUCKET=
S3_REGION=default
# Noms alternatifs facultatifs pour un service S3 compatible.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Paramètres Clever Cloud Node.js.
CC_NODE_VERSION=24
CC_NODE_BUILD_TOOL=npm-ci
CC_RUN_COMMAND=npm start
CC_HEALTH_CHECK_PATH=/healthz

# false : base vierge et aucun patient préchargé. true : démos fictives seulement.
ENABLE_DEMO_SEED=false
